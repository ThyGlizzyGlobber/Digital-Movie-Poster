[Unit]
Description=Fetch movie posters from the active discovery source (TMDb or JustWatch)
After=network-online.target posterframe-web.service
Wants=network-online.target

[Service]
Type=oneshot
User=__USER__
WorkingDirectory=__DIR__
EnvironmentFile=__DIR__/.env
Environment=POSTERFRAME_TRIGGER=schedule
ExecStart=__DIR__/venv/bin/python3 __DIR__/fetch_discovery.py
